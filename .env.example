# Template environment lokal. Copy ke `.env` lalu sesuaikan.
# JANGAN commit `.env` — file itu sudah masuk .gitignore.

# Koneksi PostgreSQL lokal (sesuai docker-compose.yml)
DATABASE_URL="postgresql://dps:dps@localhost:5432/dps_portal"

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL="info"
